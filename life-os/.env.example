# Copia este archivo como .env.local (en tu equipo) o crea estas variables en
# Vercel > Project > Settings > Environment Variables.
#
# Valores: Supabase > Project Settings > API (o "Data API").
#   - Project URL        -> NEXT_PUBLIC_SUPABASE_URL
#   - anon / publishable -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# Son los mismos que ya usa Segundo Cerebro en js/config.js.
#
# NUNCA pongas aquí la clave service_role: LIFE OS no la necesita.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon
